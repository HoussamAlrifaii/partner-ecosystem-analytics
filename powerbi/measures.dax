// create each measure separately with Modeling > New measure; this is not a batch script.

// the active date relationship is closed_date, so closed results follow the date slicer.
Net Bookings USD =
COALESCE(CALCULATE(SUM(fact_opportunity[amount_cents]), fact_opportunity[stage] = "Won") / 100.0, 0)

Booked Gross Profit USD =
COALESCE(CALCULATE(
    SUMX(fact_opportunity, fact_opportunity[amount_cents] - fact_opportunity[cost_cents]),
    fact_opportunity[stage] = "Won") / 100.0, 0)

// compute a ratio of totals; averaging individual deal margins is wrong.
Booked Margin Rate = DIVIDE([Booked Gross Profit USD], [Net Bookings USD])

Won Deals =
COALESCE(CALCULATE(COUNTROWS(fact_opportunity), fact_opportunity[stage] = "Won"), 0)

Closed Deals =
COALESCE(CALCULATE(COUNTROWS(fact_opportunity), fact_opportunity[stage] IN {"Won", "Lost"}), 0)

// a zero denominator means undefined; DIVIDE returns blank by default.
Closed Win Rate = DIVIDE([Won Deals], [Closed Deals])

// clear closed-date filters; intersect stage selections so a stage chart does not repeat the grand total.
Current Open Pipeline USD =
COALESCE(CALCULATE(SUM(fact_opportunity[amount_cents]),
    REMOVEFILTERS(dim_date),
    KEEPFILTERS(fact_opportunity[stage] IN {"Qualified", "Proposal", "Negotiation"})) / 100.0, 0)

// evaluate SUMX after removing the date filter; a FILTER table argument can capture the old context.
Current Stale Pipeline USD =
COALESCE(CALCULATE(
    SUMX(fact_opportunity,
        IF(fact_opportunity[stage] IN {"Qualified", "Proposal", "Negotiation"}
           && DATEDIFF(fact_opportunity[stage_changed_date], fact_opportunity[as_of_date], DAY) > 60,
           fact_opportunity[amount_cents], 0)),
    REMOVEFILTERS(dim_date)) / 100.0, 0)

Current Stale Pipeline Share = DIVIDE([Current Stale Pipeline USD], [Current Open Pipeline USD])

// switch the relationship only for a specifically labeled creation-cohort question.
Created Opportunities =
COALESCE(CALCULATE(COUNTROWS(fact_opportunity),
    USERELATIONSHIP(dim_date[date_key], fact_opportunity[created_date])), 0)
